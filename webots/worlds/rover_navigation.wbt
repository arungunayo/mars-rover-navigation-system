#VRML_SIM R2025a utf8
EXTERNPROTO "../protos/Sojourner.proto"
WorldInfo { basicTimeStep 32 gravity 3.73 }
Viewpoint { orientation 0.3 -0.3 -0.9 2.1 position 4 -5 5 }
Background { skyColor [ 0.15 0.18 0.23 ] }
DirectionalLight { direction -1 -1 -2 intensity 1 }
Solid {
  translation 0 0 -0.05
  children [ Shape { appearance PBRAppearance { baseColor 0.55 0.35 0.2 roughness 1 metalness 0 } geometry Box { size 12 12 0.1 } } ]
  name "ground"
  boundingObject Box { size 12 12 0.1 }
}
Solid {
  translation 2 0 0.65
  children [ Shape { appearance PBRAppearance { baseColor 0.3 0.3 0.3 } geometry Box { size 0.5 1 1.3 } } ]
  name "test obstacle"
  boundingObject Box { size 0.5 1 1.3 }
}
DEF ROVER Sojourner {
  translation 0 0 0.15
  controller "rover_navigation"
  supervisor TRUE
  extensionSlot [ GPS { name "gps" } InertialUnit { name "imu" }
    Lidar {
      translation 0 0 0.8
      name "lidar"
      horizontalResolution 360
      fieldOfView 6.283185307
      numberOfLayers 1
      minRange 0.1
      maxRange 6
    }
  ]
}

